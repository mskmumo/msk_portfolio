# --- Site ---------------------------------------------------------------
# Canonical origin used for metadata, sitemap, robots and JSON-LD.
# e.g. https://mumo.workers.dev, or a custom domain once you have one.
NEXT_PUBLIC_SITE_URL=

# --- Contact form -------------------------------------------------------
# Sent over HTTP, not SMTP: Cloudflare Workers has no TCP stack, so nodemailer
# and every other SMTP library cannot run there. See DEPLOYMENT.md.
#
# Required. Without it the form returns 503 and points visitors at email/WhatsApp.
RESEND_API_KEY=

# Optional. Where enquiries land. Defaults to mskmumo@gmail.com.
CONTACT_TO=

# Optional. Verified sender, e.g. "Mumo Mwangangi <hello@yourdomain.com>".
# Leave unset until a domain is verified in Resend — the fallback test sender
# can only deliver to the Resend account owner, so visitor confirmations are
# skipped automatically until this is set.
CONTACT_FROM=
