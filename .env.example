# --- Site ---------------------------------------------------------------
# Canonical origin used for metadata, sitemap, robots and JSON-LD.
# Leave unset on Vercel and the deployment URL is used automatically.
# Set this once a custom domain is live, e.g. https://mumomwangangi.com
NEXT_PUBLIC_SITE_URL=

# --- Contact form (SMTP) ------------------------------------------------
# Without these the form returns a 503 and tells the visitor to email directly.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password-here
SMTP_FROM=your-email@example.com
SMTP_TO=your-email@example.com
